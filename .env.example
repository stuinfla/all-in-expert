# All-In Expert - Environment Variables
# Copy this to .env and fill in your keys

# Claude API key (for LLM-powered query synthesis)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# AssemblyAI API key (optional - for speaker diarization)
# Get from: https://www.assemblyai.com/app/account
# Cost: ~$0.17/hr of audio (~$51 for full podcast catalog)
ASSEMBLYAI_API_KEY=

# OpenAI API key (REQUIRED). Used for BOTH the corpus vectors in
# web/public/data/embeddings.bin and the per-query embedding in /api/ask.
# Both sides must use text-embedding-3-small @ 384 dims or cosine similarity
# returns noise. Diagnosing failures: HTTP 401 = bad/revoked key;
# HTTP 429 insufficient_quota = the ACCOUNT is out of credit (rotating the
# key will NOT help — top up the balance at platform.openai.com).
OPEN_AI_KEY=

# QA bypass token. Lets scripts/cache-warm.mjs and scripts/qa-ci.mjs skip the
# per-IP rate limit on /api/ask. Must also be set in the Vercel project env.
QA_BYPASS_TOKEN=

# ntfy.sh topic for pipeline failures and semantic-search degradation alerts.
# On ntfy.sh the topic name IS the credential: anyone who knows it can read
# your alerts or publish spoofed ones. NEVER commit a real value — this repo
# is public. Subscribe to it once in the ntfy app.
AIE_NTFY_TOPIC=
